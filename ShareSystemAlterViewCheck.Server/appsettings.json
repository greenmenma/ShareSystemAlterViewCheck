{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "VerifyDb": "Server=VERIFY-SQL;Database=ShareSystemVerify;Integrated Security=true;TrustServerCertificate=true;Application Name=ShareSystemAlterViewCheck"
  },
  "Verification": {
    "LogDirectory": "App_Data/logs",
    "MaxRunMinutes": 30
  },
  "HostRedirect": {
    "Enabled": true,
    "DefaultDomain": "example.local",
    "HttpsPort": 443
  }
}
